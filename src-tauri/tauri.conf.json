{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/v2/crates/tauri-config-schema/schema.json",
  "productName": "奶昔",
  "version": "0.1.0",
  "identifier": "com.naixi.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/stage-core.cjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "奶昔 · Naixi",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "devtools": true,
        "visible": false
      },
      {
        "label": "pet",
        "title": "奶昔桌宠",
        "width": 400,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true,
        "visible": false,
        "url": "/pet"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:9845 http://localhost:9845 ws://127.0.0.1:9845 ws://localhost:9845; img-src 'self' data: blob: https: http://127.0.0.1:9845; media-src 'self' data: blob: https: http://127.0.0.1:9845; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "installMode": "currentUser",
        "template": "installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/uninstall.ico",
        "compression": "zlib"
      },
      "signCommand": "powershell -NoProfile -Command \"& { if ($env:NAIXI_CODESIGN_PFX -and $env:NAIXI_CODESIGN_THUMB -and $env:NAIXI_SIGNTOOL) { & $env:NAIXI_SIGNTOOL sign /fd SHA256 /sha1 $env:NAIXI_CODESIGN_THUMB /tr http://timestamp.digicert.com /td SHA256 $env:NAIXI_CODESIGN_PFX $file } }\"",
      "digestAlgorithm": "sha256"
    },
    "resources": [
      "sidecar/*.py",
      "resources/desktop_core/**/*.py",
      "resources/desktop_core/vrm_html/**/*",
      "resources/data/**/*",
      "resources/python-embed/**/*"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
