# 数据库（含用户创建的工作流、模板等数据）
data/

# Node
node_modules/
dist/
*.tsbuildinfo

# Rust / Tauri
src-tauri/target/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local

# Python 缓存
__pycache__/
*.pyc

# 内置 SearXNG（154MB，打包时附加下载）
searxng/

# 工作区文件（用户创建的临时文件）
workspace/
__pycache__/
logs/
_motions/
logs/
pet_debug.log
pet_init.log

# 打包生成的资源（自包含 Python 运行时 + 暂存的纯代码桌面核心，体积大不入库）
src-tauri/resources/

# Godot 导出缓存（纯生成物，含空值导出凭据）
godot_renderer/.godot/
# Godot 导出产物与模型资源（体积大，不入库）
godot_renderer/export/
godot_renderer/models/
# Godot 场景引用的 3D 模型本体（单文件超 GitHub 100MB 上限，不入库，需自备）
godot_renderer/scenes/*.vrm

# 通用 Rust 构建目录（防子目录遗漏）
/target/

# 构建/运行日志与临时产物（不入库，可能含本地路径）
*.log
tauri_err.txt
tauri_out.txt
build_log_*.txt
verify_shots/
install_gui.log
verify2.log
